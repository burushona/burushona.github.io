@article{kozhanovVariationValencyPatterns2025a,
  year = {2025},
  title = {Variation in Valency Patterns across {{Romani}} Dialects Is Primarily Shaped by Contact Languages},
  author = {Kozhanov, Kirill and Say, Sergey},
  date = {2025-10-27},
  journal = {Studies in Language},
  shortjournal = {Stud. Lang.},
  volume = {49},
  number = {4},
  pages = {858--893},
  issn = {0378-4177, 1569-9978},
  doi = {10.1075/sl.23067.koz},
  url = {http://www.jbe-platform.com/content/journals/10.1075/sl.23067.koz},
  urldate = {2026-02-16},
  abstract = {Abstract             This paper examines the effects of language contact on valency patterns by comparing Romani dialects with their 					contact languages. Due to their wide dispersion and extensive contact with diverse European languages, Romani dialects provide an 					excellent testing ground for exploring the interplay of genealogical and areal factors in valency encoding. Using data from the 					Romani morpho-syntax database (RMS) and BivalTyp, a typological database of bivalent verbs, we analyzed valency patterns in 43 					predicates across 119 Romani varieties and 18 contact languages. Despite their relatively recent divergence (600–700 years), 					Romani dialects exhibit greater variation in valency patterns than some genealogical groups with a 2000-year history. These 					patterns align more closely with current geographic distribution and contact languages than with traditional genealogical 					classifications. The findings suggest that language contact is the primary driver of rapid changes in Romani valency systems, as 					some dialects resemble their contact languages more than other Romani varieties.},
  langid = {english}
}

@article{kozhanovEvolutionArealExpansion2025a,
  year = {2025},
  title = {Evolution and Areal Expansion of Differential Object Marking in {{Romani}}},
  author = {Kozhanov, Kirill and Seržant, Ilja~A.},
  date = {2025-08-18},
  journal = {Language Dynamics and Change},
  shortjournal = {Lang. Dyn. Change},
  volume = {15},
  number = {1},
  pages = {1--37},
  issn = {2210-5832},
  doi = {10.1163/22105832-bja10037},
  url = {https://brill.com/view/journals/ldc/15/1/article-p1_3.xml},
  urldate = {2026-02-09},
  abstract = {Abstract                            This article traces the evolution of differential object marking (               DOM               ) in Romani, an Indo-Aryan language primarily spoken in Europe in contact with different languages. Drawing on dialectological data from 119 locations in Europe, we demonstrate that               DOM               in Romani dialects is generally a stable feature constrained by the pronoun vs. noun distinction, animacy, and—in some conservative varieties—definiteness. By comparing Romani with other Indo-Aryan languages, we propose a diachronic scenario. An indirect object case marker expands into marking direct objects, starting with pronouns, then definite animate nouns, and finally, encompassing all animate nouns. This developmental sequence is reflected in the distribution of               DOM               -constraining factors in contemporary dialects. By contrast, Romani dialects of Finland are undergoing the process of losing               DOM               , while Italian varieties have lost it completely by forfeiting nominal case inflection altogether. However, in the varieties of southern Italy this loss is compensated by a new prepositional               DOM               , a pattern replication from dialectal Italian.}
}

@article{ovsjannikovaNonUrmiNorthEasternNeoAramaic2026,
  year = {2026},
  title = {Non-{{Urmi North-Eastern Neo-Aramaic}} Varieties in the Village of {{Urmiya}}, {{Russia}}: {{Distinctive}} Features of Phonology and Morphology},
  shorttitle = {Non-{{Urmi North-Eastern Neo-Aramaic}} Varieties in the Village of {{Urmiya}}, {{Russia}}},
  author = {Ovsjannikova, Maria and Zabelina, Elizaveta and Kozhanov, Kirill},
  date = {2026-02-04},
  journal = {Journal of Semitic Studies},
  shortjournal = {J. Semit. Stud.},
  pages = {fgaf041},
  issn = {0022-4480, 1477-8556},
  doi = {10.1093/jss/fgaf041},
  url = {https://academic.oup.com/jss/advance-article/doi/10.1093/jss/fgaf041/8457545},
  urldate = {2026-02-08},
  abstract = {Abstract             The paper discusses North-Eastern Neo-Aramaic (NENA) varieties spoken in the village of Urmiya in Krasnodar Krai, Russia, where Assyrians constitute the majority of the population. The Christian Urmi dialect is the dominant NENA variety in the village. We focus on non-Urmi varieties represented in the village, specifically on the variety spoken by the so-called šapətné Assyrians. Although its name suggests a relation to the village of Shapat in the Hakkari region of southeastern Turkey, we argue that in Urmiya, the ethnonym šapətné has likely become an exonym used by the Urmi Assyrians to refer to Assyrians of varying origin from southeastern Turkey. We discuss the sociolinguistic composition of the village, as well as the distinctive phonetic and morphological features of the variety spoken by the šapətné against Christian Urmi and other relevant NENA dialects. We identify northern Hakkari varieties and the Van dialect as closest to the major non-Urmi varieties of Urmiya.},
  langid = {english}
}

@incollection{ackema_borrowing_2023,
	edition = {1},
	title = {Borrowing of {Morphology}: {With} a {Case} {Study} of {Baltic} and {Slavic} {Verbal} {Prefixes}},
	isbn = {9781119693574 9781119693604},
	shorttitle = {Borrowing of {Morphology}},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/9781119693604.morphcom011},
	abstract = {Abstract 
            This is a survey of the domain of morphological borrowing complemented with a case study of contact‐induced phenomena in the domain of verbal prefixes in Baltic, Slavic and neighbouring languages. Section 2 presents a concise overview of the main divisions and analytical problems of morphological borrowing, focusing on the distinction between matter borrowing and pattern borrowing, on the one hand, and on the borrowing of different types of morphology (e.g. derivation vs inflection, affixes vs processes, etc.). Section 3 further illustrates these issues on the basis of the data of the borrowing phenomena involving verbal prefixes in Baltic and Slavic, such as borrowing of individual prefixes from Slavic into Baltic dialects and of whole systems of prefixes from Slavic into Romani and Istro‐Romanian and from Baltic into Livonian, as well as cases of pattern replication involving verbal prefixes in Lithuanian, Yiddish and Romani. The borrowability of the Slavic and Baltic verbal aspect expressed by means of prefixation is also discussed, and it is shown that the aspectual values of borrowed prefixes are never exact copies of their counterparts in the source languages.},
	bibtex_show={true},
	language = {en},
	urldate = {2023-11-28},
	booktitle = {The {Wiley} {Blackwell} {Companion} to {Morphology}},
	publisher = {Wiley},
	author = {Arkadiev, Peter and Kozhanov, Kirill},
	editor = {Ackema, Peter and Bendjaballah, Sabrina and Bonet, Eulàlia and Fábregas, Antonio},
	month = sep,
	year = {2023},
	doi = {10.1002/9781119693604.morphcom011},
	pages = {1--33},
}


